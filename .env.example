# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: raises GitHub search rate limit from 10 to 30 req/min
GITHUB_TOKEN=

# Gmail SMTP for battlecard delivery (use an App Password, not your login password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
