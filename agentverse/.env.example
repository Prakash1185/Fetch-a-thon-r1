# Public URL of the Next.js deployment (no trailing /api/scout needed, but accepted)
SCOUT_API_URL=https://your-app.vercel.app

# Optional: default inbox when the chat message does not include an email
SCOUT_DEFAULT_EMAIL=

# Optional: rapid | recon | deep-dive
SCOUT_MODE=recon

# Local mailbox testing only. Do not commit real values.
AGENT_SEED=
AGENT_MAILBOX=false
